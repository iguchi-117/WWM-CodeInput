# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.spec

# PyInstaller build (ソースのみで十分)
build/
*.spec

# テスト環境の一時フォルダ
# (WWM_TEST_USE_PYTHON=1 で生成される temp フォルダは .git 管理外)

# Settings/codes.json は EXE と同じフォルダで管理されているため、
# リポジトリには含めない (ルートも dist 配下も同様)
settings.json
codes.json
codes.backup.json
dist/codes.json
dist/codes.backup.json
dist/settings.json
dist/settings.json.bak

# 一時退避バックアップ (*-backup-YYYYMMDD.json) はコミットしない
*-backup-*.json

# テスト用ログ
_exe_log.txt
_exe_stdout.txt
_exe_stderr.txt
_dbg.txt
_dbg_err.txt

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# G4実測の確定直後キャプチャ (shots/ は証跡化後に .hermes/evidence/g4_fail/ へ移動)
shots/
